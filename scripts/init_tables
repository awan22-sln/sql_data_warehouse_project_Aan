/*
Use this for create the table and reset if there already one, this is the tables that i use for
*/

--Create Table

DROP TABLE IF EXISTS bronze."bronze.crm_cust_info";

CREATE TABLE bronze."bronze.crm_cust_info"(
	cst_id INT,
	cst_key VARCHAR(50),
	cst_firstname VARCHAR(50),
	cst_lastname VARCHAR(50),
	cst_material_status VARCHAR(50),
	cst_gndr VARCHAR(50),
	cst_create_date DATE);

ALTER TABLE IF EXISTS bronze."bronze.crm_cust_info"
    OWNER to postgres;


DROP TABLE IF EXISTS bronze."bronze.crm_prd_info";

CREATE TABLE bronze."bronze.crm_prd_info"(
	prd_id INT,
	prd_key VARCHAR(50),
	prd_nm VARCHAR(50),
	prd_cost INT,
	prd_line VARCHAR(50),
	prd_start_date TIMESTAMP,
	prd_create_date TIMESTAMP);

ALTER TABLE IF EXISTS bronze."bronze.crm_prd_info"
    OWNER to postgres;


DROP TABLE IF EXISTS bronze."bronze.crm_sls_info";

CREATE TABLE bronze."bronze.crm_sls_info"(
	sls_ord_num VARCHAR(50),
	sls_prd_key VARCHAR(50),
	sls_cust_id INT,
	sls_order_dt INT,
	sls_ship_dt INT,
	sls_due_dt INT,
	sls_sales INT,
	sls_quantity INT,
	sls_price INT);

ALTER TABLE IF EXISTS bronze."bronze.crm_sls_info"
    OWNER to postgres;


DROP TABLE IF EXISTS bronze."bronze.erp_loc_a101";

CREATE TABLE bronze."bronze.erp_loc_a101"(
	cid VARCHAR(50),
	cntry VARCHAR(50));

ALTER TABLE IF EXISTS bronze."bronze.erp_loc_a101"
    OWNER to postgres;


DROP TABLE IF EXISTS bronze."bronze.erp_cust_az12";

CREATE TABLE bronze."bronze.erp_cust_az12"(
	cid VARCHAR(50),
	bdate DATE,
	gen VARCHAR(50));

ALTER TABLE IF EXISTS bronze."bronze.erp_cust_az12"
    OWNER to postgres;


DROP TABLE IF EXISTS bronze."bronze.erp_px_cat_g1v2";

CREATE TABLE bronze."bronze.erp_px_cat_g1v2"(
	"id" VARCHAR(50),
	cat VARCHAR(50),
	subcat VARCHAR(50),
	maintenance VARCHAR(50)):;

ALTER TABLE IF EXISTS bronze."bronze.erp_px_cat_g1v2"
    OWNER to postgres;
