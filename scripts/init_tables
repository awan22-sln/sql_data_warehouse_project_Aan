/*
Use this for create the table and reset if there already one, this is the tables that i use for
*/

--Create Table

DROP TABLE IF EXISTS bronze."bronze.erp_ssd_sales";

CREATE TABLE bronze."bronze.erp_ssd_sales"(
	"Date" VARCHAR,
	"Time" VARCHAR,
	"Item Code" VARCHAR,
	"Quantity Sold (Kg)" VARCHAR,
	"Unit Selling Price (RMB/Kg)" VARCHAR,
	"Sale or Return" VARCHAR,
	"Discount (Yes/No)" VARCHAR);

ALTER TABLE IF EXISTS bronze."bronze.erp_ssd_sales"
    OWNER to postgres;


DROP TABLE IF EXISTS bronze."bronze.erp_ssd_product";

CREATE TABLE bronze."bronze.erp_ssd_product"(
	"Item Code" VARCHAR,
	"Item Name" VARCHAR,
	"Category Code" VARCHAR,
	"Category Name" VARCHAR);

ALTER TABLE IF EXISTS bronze."bronze.erp_ssd_product"
    OWNER to postgres;


DROP TABLE IF EXISTS bronze."bronze.erp_ssd_price";

CREATE TABLE bronze."bronze.erp_ssd_price"(
	"Date" VARCHAR,
	"Item Code" VARCHAR,
	"Wholesale Price (RMB/Kg)" VARCHAR);

ALTER TABLE IF EXISTS bronze."bronze.erp_ssd_price"
    OWNER to postgres;


DROP TABLE IF EXISTS bronze."bronze.erp_ssd_lossrate";

CREATE TABLE bronze."bronze.erp_ssd_lossrate"(
	"Item Code" VARCHAR,
	"Item Name" VARCHAR,
	"Loss Rate (%)" VARCHAR);

ALTER TABLE IF EXISTS bronze."bronze.erp_ssd_lossrate"
    OWNER to postgres;
